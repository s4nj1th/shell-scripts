#!/bin/bash

input_ext="webm"
output_ext="mp4"
input_path=""
remove_original=0

while getopts ":f:t:r" opt; do
  case $opt in
    f) input_ext="$OPTARG" ;;
    t) output_ext="$OPTARG" ;;
    r) remove_original=1 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; exit 1 ;;
  esac
done

shift $((OPTIND-1))

if [ $# -lt 1 ]; then
  echo "Usage: $0 [-f from_ext] [-t to_ext] [-r] <input_path>"
  echo "Options:"
  echo "  -f    Input file extension (default: webm)"
  echo "  -t    Output file extension (default: mp4)"
  echo "  -r    Remove original file after conversion"
  echo "Examples:"
  echo "  $0 -f webm -t mp4 -r /path/to/files"
  echo "  $0 -t avi -r video.webm (auto-detect input extension)"
  echo "  $0 . (process all webm files in current dir, keep originals)"
  exit 1
fi

input_path="$1"

if [ -f "$input_path" ] && ! [[ "$*" =~ "-f" ]]; then
  filename=$(basename -- "$input_path")
  input_ext="${filename##*.}"
fi

process_file() {
  local input_file="$1"
  local output_file="${input_file%.*}.$output_ext"
  local ip=$(basename "$input_file")
  local op=$(basename "$output_file")
  
  echo "Converting: $ip -> $op"
  ffmpeg -i "$input_file" "$output_file" -loglevel quiet

  if [ $? -eq 0 ]; then
    echo "Successfully converted $ip"
    if [ $remove_original -eq 1 ]; then
      rm "$input_file"
      echo "Removed original file: $ip"
    fi
  else
    echo "Error converting $ip" >&2
    return 1
  fi
}

if [ -f "$input_path" ]; then
  process_file "$input_path"
elif [ -d "$input_path" ]; then
  echo "Processing all .$input_ext files in directory: $input_path"
  for file in "$input_path"/*."$input_ext"; do
    if [ -f "$file" ]; then
      process_file "$file"
    fi
  done
else
  echo "Error: Input path '$input_path' is neither a file nor a directory" >&2
  exit 1
fi

echo "Conversion complete"
